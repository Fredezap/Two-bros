// Opciones para el momento de uso del ingrediente en la receta
enum UsageMoment {
  boil
  mash
  hopstand
  whirlpool
  dry_hop
}

// Unidad de tiempo para el campo time
enum TimeUnit {
  minutes
  days
}
// Esquema de la Base de Datos PostgreSQL para BrewPilot

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================================================================
// UTILS
// ===================================================================

enum BrewStatus {
  in_progress
  finished
  cancelled
}


// ===================================================================
// MASTER TABLES
// ===================================================================

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  passwordHash String @map("password_hash")
  isEmailVerified Boolean @default(false) @map("is_email_verified")
  verificationToken String? @map("verification_token")
  verificationTokenExpires DateTime? @map("verification_token_expires")
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")
  lockUntil DateTime? @map("lock_until")
  lastLoginAt DateTime? @map("last_login_at")
  lastLoginIp String? @map("last_login_ip")
  createdAt DateTime @default(now()) @map("created_at")

  recipes   Recipe[]
  brews     Brew[]
  refreshTokens RefreshToken[]

  ingredients Ingredient[]

  loginAttempts LoginAttempt[]
  devices       UserDevice[]

  @@map("users")
}

model Style {
  id        String    @id @default(uuid())
  name      String    @db.VarChar(255)
  description String?
  deletedAt DateTime? @map("deleted_at")

  recipes   Recipe[]

  @@unique([name, deletedAt])
  @@map("styles")
}

model Ingredient {
  id        String    @id @default(uuid())
  name      String
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  // ===================================================================
  // REFRESH TOKENS
  // ===================================================================
  // (El modelo RefreshToken se moverá fuera de Ingredient)
  type      String
  unitOfMeasure String @map("unit_of_measure")
  stock     Decimal   @default(0) @db.Decimal(10, 3)
  reorderThreshold Decimal @map("reorder_threshold") @default(0) @db.Decimal(10, 3)
  isInStock Boolean   @default(false) @map("is_in_stock")
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")

  recipeIngredients RecipeIngredient[]

  @@unique([name, userId, deletedAt])
  @@map("ingredients")
}

// ===================================================================
// REFRESH TOKENS (fuera de Ingredient)
// ===================================================================
model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  tokenHash  String   @map("token_hash")
  type       String   @db.VarChar(32)
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?
  ip         String?

  @@index([userId])
  @@map("refresh_tokens")
}

model Recipe {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  styleId   String?   @map("style_id")

  name      String
  batchLiters Decimal @map("batch_liters") @db.Decimal(10, 3)
  ibu       Decimal?  @db.Decimal(5, 2)
  colorSrm  Decimal?  @map("color_srm") @db.Decimal(5, 2)
  alcoholPercent Decimal? @map("alcohol_percent") @db.Decimal(4, 2)
  details   Json?     // { og: Float?, fg: Float?, mashWater: Float?, spargeWater: Float?, ... }
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id])
  style     Style?    @relation(fields: [styleId], references: [id])
  ingredients RecipeIngredient[]
  brews       Brew[]

  @@map("recipes")
}

model RecipeIngredient {
  recipeId    String    @map("recipe_id")
  ingredientId String @map("ingredient_id")
  quantity    Decimal   @db.Decimal(10, 3)
  usageMoment UsageMoment? @map("usage_moment")
  time        Int?
  timeUnit    TimeUnit?

  recipe      Recipe    @relation(fields: [recipeId], references: [id])
  ingredient  Ingredient @relation(fields: [ingredientId], references: [id])

  // Sin restricciones únicas: se permite más de un registro del mismo ingrediente
  @@map("recipe_ingredients")
  id String @id @default(uuid())
}

model Brew {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  recipeId      String    @map("recipe_id")
  batchLiters   Decimal   @map("batch_liters") @db.Decimal(10, 3)
  status        BrewStatus @default(in_progress)
  brewDate      DateTime  @map("brew_date") @default(now())
  bottlingDate  DateTime? @map("bottling_date")
  notes         String?
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id])
  recipe        Recipe    @relation(fields: [recipeId], references: [id]) // RESTRICT for integrity

  @@map("brews")
}

// Registro de intentos de login
model LoginAttempt {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  email     String
  ip        String?
  userAgent String?
  deviceId  String?
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id])

  @@map("login_attempts")
}

// Registro de dispositivos/sesiones activas
model UserDevice {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  deviceId   String
  deviceName String?
  ip         String?
  lastSeen   DateTime @default(now()) @map("last_seen")
  createdAt  DateTime @default(now()) @map("created_at")
  isActive   Boolean  @default(true)

  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
  @@map("user_devices")
}

