/**
 * Backup del archivo original `prisma.config.ts` renombrado para evitar que
 * el CLI de Prisma intente parsearlo como TypeScript (causaba un fallo de parseo).
 * Si necesitas volver a usar la versión TypeScript, restaura este archivo.
 */
export default {
  datasources: [
    {
      name: 'db',
      url: `postgresql://${process.env.PG_AUTH_USER}:${process.env.PG_PASSWORD}@${process.env.PG_HOST}:${process.env.PG_PORT}/${process.env.PG_DATABASE}?schema=public`,
    },
  ],
};
